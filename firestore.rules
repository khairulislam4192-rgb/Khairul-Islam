rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document or userId matches
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles - authenticated users can read, owner can manage
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || !isAuthenticated();
      allow delete: if isOwner(userId);
    }

    // User Cloud Files & Vault - strictly isolated per user
    match /userFiles/{fileId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? request.resource.data.userId == request.auth.uid : true;
      allow update, delete: if isAuthenticated() ? resource.data.userId == request.auth.uid : true;
    }

    // Products (Inventory)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Orders & Invoices
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store Settings
    match /storeSettings/{settingId} {
      allow read, write: if true;
    }
  }
}
