rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || !isAuthenticated();
      allow delete: if isOwner(userId);
    }

    // User Cloud Files & Vault - strictly isolated per user
    match /userFiles/{fileId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? request.resource.data.userId == request.auth.uid : true;
      allow update, delete: if isAuthenticated() ? resource.data.userId == request.auth.uid : true;
    }

    // Products (Inventory) - Isolated by userId
    match /products/{productId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? (request.resource.data.userId == request.auth.uid) : true;
      allow update, delete: if isAuthenticated() ? (resource.data.userId == request.auth.uid) : true;
    }

    // Customers - Isolated by userId
    match /customers/{customerId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? (request.resource.data.userId == request.auth.uid) : true;
      allow update, delete: if isAuthenticated() ? (resource.data.userId == request.auth.uid) : true;
    }

    // Orders & Invoices - Isolated by userId
    match /orders/{orderId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? (request.resource.data.userId == request.auth.uid) : true;
      allow update, delete: if isAuthenticated() ? (resource.data.userId == request.auth.uid) : true;
    }

    // Returns & Restock - Isolated by userId
    match /returns/{returnId} {
      allow read: if isAuthenticated() ? (resource == null || resource.data.userId == request.auth.uid) : true;
      allow create: if isAuthenticated() ? (request.resource.data.userId == request.auth.uid) : true;
      allow update, delete: if isAuthenticated() ? (resource.data.userId == request.auth.uid) : true;
    }

    // Store Settings
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

